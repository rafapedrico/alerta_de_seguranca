<?xml version="1.0" encoding="utf-8"?>
<!-- Widget SOS: quadrado, 1x1 por padrão, redimensionável. Sem dados
     dinâmicos — nunca precisa atualizar sozinho (updatePeriodMillis 0). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/sos_widget_descricao"
    android:initialLayout="@layout/sos_widget"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/sos_widget"
    android:previewLayout="@layout/sos_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
