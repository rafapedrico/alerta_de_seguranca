<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.WRITE_CONTACTS"/>
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Exigida para o Android sequer OFERECER a opção "Permitir o tempo
         todo" (background location) — ver OnboardingScreen/OnboardingService,
         item "Localização sempre ativa". Sem esta declaração no manifest,
         Permission.locationAlways/Geolocator.requestPermission() nunca
         retorna LocationPermission.always, mesmo com o usuário tentando
         conceder manualmente em Configurações. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <!-- Exigida pelo Android 14+ para declarar um Foreground Service do
         tipo "dataSync" (ver SosDispatchService) — janela crítica de
         envio do SMS/upload do SOS que sobrevive à morte da Activity. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Rastreamento contínuo da aba Monitoramento (RastreamentoContinuoService,
         foregroundServiceType="location") — exigida a partir do Android 14. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <uses-permission android:name="android.permission.DISABLE_KEYGUARD"/>

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Isenção de otimização de bateria/Doze agressivo do fabricante —
         ver BatteryOptimizationService. Só a permissão de PEDIR a
         isenção (abre a tela nativa de confirmação); a concessão em si
         é sempre uma decisão explícita do usuário. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- Cronômetro no modo vibrar e despertador com o "Toque Silencioso"
         vibram em loop (ver RotinaAlarmWakeService). -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- Activity Principal -->
        <!-- SEM showWhenLocked: diferente de RotinaCheckinAlarmActivity e
             LockscreenCameraActivity (subclasses desta, cada uma com sua
             PRÓPRIA entrada no manifest e sua própria configuração dinâmica
             de setShowWhenLocked/setTurnScreenOn em onCreate — ver essas
             classes), esta Activity NUNCA deve desenhar por cima do
             Keyguard sem autenticação — inclusive quando aberta pelo
             SolicitacaoMonitoramentoWakeService (solicitação de localização
             via FCM): o usuário deve desbloquear o Android normalmente
             primeiro, e só então ver a tela de Login do app. turnScreenOn
             continua presente só para acender a tela (mostrando a própria
             lockscreen do Android com a notificação) — nunca para
             dispensar o bloqueio. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:turnScreenOn="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Activity de Rotina / Checkin -->
        <activity
            android:name=".RotinaCheckinAlarmActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>

        <!-- Activity Dedicada à Câmera na Lockscreen -->
        <activity
            android:name=".LockscreenCameraActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".lockscreen_camera"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Login social com Facebook REMOVIDO em 2026-08-23 (decisão de
             arquitetura) — este boilerplate (meta-data ApplicationId/
             ClientToken + FacebookActivity/CustomTabActivity) ficava aqui
             para a Facebook SDK nativa, agora sem uso. -->

        <!-- Canal padrão do firebase_messaging para mensagens que
             chegam sem um canal explícito — um dos canais de "Alerta de
             Emergência Recebido" criados por NotificacaoService.inicializar()
             (alerta_recebido_som_N, som da notificação no volume atual). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="alerta_recebido_som_1" />

        <receiver
            android:name="dev.fluttercommunity.plus.androidalarmmanager.AlarmBroadcastReceiver"
            android:exported="false"/>
        <receiver
            android:name="dev.fluttercommunity.plus.androidalarmmanager.RebootBroadcastReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <service
            android:name="dev.fluttercommunity.plus.androidalarmmanager.AlarmService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>

        <service
            android:name="com.dexterous.flutterlocalnotifications.ForegroundService"
            android:exported="false"
            android:stopWithTask="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <service
            android:name=".VolumeSosService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitoramento do botao fisico de SOS de seguranca pessoal"/>
        </service>

        <!-- Reinicia o VolumeSosService após reboot/atualização do app —
             sem isso, o monitoramento do botão físico só voltava a rodar
             depois que o usuário abrisse o app manualmente pelo menos
             uma vez (ver VolumeSosBootReceiver). -->
        <receiver
            android:name=".VolumeSosBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Rastreamento contínuo da aba Monitoramento (ver
             RastreamentoContinuo.kt): foreground service de localização,
             ligado só com consentimento explícito do usuário e a permissão
             "Permitir o tempo todo"; religado após reiniciar o aparelho
             pelo RastreamentoBootReceiver, se estava ligado. -->
        <service
            android:name=".RastreamentoContinuoService"
            android:exported="false"
            android:foregroundServiceType="location"/>
        <receiver
            android:name=".RastreamentoBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Despertador e Cronômetro Regressivo: caminho 100% nativo
             (bypassa Doze), acorda o aparelho e toca durante toda a
             tolerância, mesmo com a tela bloqueada ou o app fechado. -->
        <receiver
            android:name=".RotinaAlarmNativeReceiver"
            android:exported="false"/>
        <service
            android:name=".RotinaAlarmWakeService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Despertador e cronometro de seguranca pessoal (check-in com PIN)"/>
        </service>

        <!-- Localização a cada 1 min durante o cronômetro e nas 2 h antes de
             cada despertador (ver VigiaLocalizacao.kt). -->
        <service
            android:name=".VigiaLocalizacaoService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location"/>
        <receiver
            android:name=".VigiaLocalizacaoReceiver"
            android:exported="false"/>

        <!-- Rearma cronômetro, despertadores e janelas de localização depois
             de reiniciar o aparelho, atualizar o app ou conceder a permissão
             de alarme exato (ver DespertadorAgenda.kt). -->
        <receiver
            android:name=".GxAlarmesBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Janela crítica de disparo do SOS (SMS nativo + upload da foto
             ao Firebase Storage/Firestore) — mantém o processo vivo
             durante o envio, independente da Activity/engine principal
             ser destruída (ver SosDispatchService/SosDisparoService). -->
        <service
            android:name=".SosDispatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <!-- Solicitação de localização (aba Monitoramento) via FCM: mesmo
             caminho 100% nativo do botão de SOS/alarme de rotina acima —
             acorda o aparelho e abre o MainActivity por cima da lockscreen,
             sem depender do fullScreenIntent da API de Notificação
             (pouco confiável nestes aparelhos com a tela bloqueada). Este
             receiver é ADICIONAL ao do plugin firebase_messaging — o
             Android entrega o mesmo broadcast a ambos, sem conflito. -->
        <receiver
            android:name=".SolicitacaoMonitoramentoFcmReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE"/>
            </intent-filter>
        </receiver>
        <service
            android:name=".SolicitacaoMonitoramentoWakeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Solicitacao de localizacao recebida (acordar tela)"/>
        </service>

        <!-- Device Admin — única forma de bloquear a tela sob demanda
             (DevicePolicyManager.lockNow(), ver DeviceAdminPlugin/
             GuardiaoDeviceAdminReceiver), usada na P4 da sequência
             unificada de SOS (ver SosDisparoService/CameraCapturaScreen).
             android:exported="true" + android:permission=BIND_DEVICE_ADMIN
             são exigidos pelo próprio Android para qualquer receiver de
             Device Admin, independente do restante do app ser privado. A
             ativação NUNCA é automática — exige o usuário aceitar o
             diálogo nativo disparado por
             DeviceAdminPlugin.solicitarAtivacao(), com antecedência, via
             tela de consentimento em Configurações/Segurança. -->
        <receiver
            android:name=".GuardiaoDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver"/>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
            </intent-filter>
        </receiver>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="whatsapp"/>
        </intent>
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
    </queries>
</manifest>