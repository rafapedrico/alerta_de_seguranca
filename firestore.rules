rules_version = '2';

// Regras de produção: o app usa Firebase Auth real (e-mail/senha, ver
// FirebaseAuthService) e cada documento de usuário é identificado pelo
// `uid` do Firebase Auth — não mais pelo antigo `usuarioId` fixo em
// memória. Toda leitura/escrita exige `request.auth != null` e, na
// maioria dos casos, que `request.auth.uid` seja o dono do recurso.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{usuarioId} {
      // Documento por usuário: perfil (nome/email/telefone/fcmToken),
      // localização atual e contatos de emergência sincronizados (ver
      // FirebaseSyncService).
      allow read: if request.auth != null && request.auth.uid == usuarioId;

      // Criação do perfil (cadastro, ver
      // FirebaseSyncService.criarPerfilInicial) — só o próprio dono, e
      // NUNCA definindo os campos do ciclo do Plano Free (ver abaixo).
      allow create: if request.auth != null && request.auth.uid == usuarioId &&
          !request.resource.data.keys().hasAny(['isPremium', 'cycleStartDate', 'blockedAt']);

      // Atualizações do próprio dono (localização periódica, contatos de
      // emergência, fcmToken, etc.) — PROTEÇÃO DE SERVIDOR do ciclo do
      // Plano Free (pedido explícito do usuário, "trava de servidor" para
      // que reinstalar o app ou adulterar o cliente não reinicie/burle o
      // ciclo): `isPremium`/`cycleStartDate`/`blockedAt` NUNCA podem ser
      // alterados por uma escrita vinda do cliente, mesmo o próprio dono —
      // só a Cloud Function `sincronizarCicloPlano`/
      // `cancelarPremiumDoProprioUsuario` (Admin SDK, ignora estas regras)
      // pode gravá-los. Ver `functions/planoCicloService.js`.
      allow update: if request.auth != null && request.auth.uid == usuarioId &&
          !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['isPremium', 'cycleStartDate', 'blockedAt']);

      allow delete: if false;

      match /alertas/{alertaId} {
        // O app só precisa CRIAR um novo alerta (ver
        // FirebaseSyncService.dispararAlertaTentativaDesarmeIncorreto).
        allow create: if request.auth != null && request.auth.uid == usuarioId;
        allow read: if request.auth != null && request.auth.uid == usuarioId;
        // Só a Cloud Function (via Admin SDK, que ignora estas regras)
        // deve atualizar o alerta (ex: marcar como `processado`) — o
        // cliente nunca deve alterar ou apagar um alerta já criado.
        allow update, delete: if false;
      }

      match /monitoramento/atual {
        // Espelho GRAVADO PELO PRÓPRIO DONO (mesmo heartbeat de
        // localização já usado pelo alarme de pânico, ver
        // FirebaseSyncService.atualizarLocalizacaoAtual) num documento
        // SEPARADO do `usuarios/{usuarioId}` principal — necessário
        // porque aquele documento tem campos estritamente privados
        // (fcmToken) que NUNCA podem ser lidos por terceiros,
        // enquanto este espelho existe justamente para ser lido por quem
        // tiver uma permissão "aprovado" na aba Monitoramento.
        allow read: if request.auth != null &&
            (request.auth.uid == usuarioId ||
             (exists(/databases/$(database)/documents/permissoes_monitoramento/$(usuarioId + '__' + request.auth.uid)) &&
              get(/databases/$(database)/documents/permissoes_monitoramento/$(usuarioId + '__' + request.auth.uid)).data.status == 'aprovado'));
        allow write: if request.auth != null && request.auth.uid == usuarioId;
      }
    }

    match /alarmes_agendados/{idAlarme} {
      // Documento de monitoramento agendado (ver AlarmeAgendadoModel /
      // BackgroundLocationHeartbeatService / RotinaAlarmeService no app):
      // o próprio aparelho precisa criar/atualizar (heartbeat de
      // localização a cada 2 min) e marcar CONFIRMADO_SEGURA ao digitar o
      // PIN correto — sempre restrito ao dono (`usuarioId` gravado no
      // próprio documento). A Cloud Function agendada (que marca
      // ALERTA_DISPARADO) usa o Admin SDK e ignora estas regras.
      allow read: if request.auth != null &&
          request.auth.uid == resource.data.usuarioId;
      allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.usuarioId;
      allow update: if request.auth != null &&
          request.auth.uid == resource.data.usuarioId;
      allow delete: if false;
    }

    match /entregas_alerta/{idEntrega} {
      // Rastreamento do pipeline de alerta via Push FCM (ver
      // functions/alertaHibridoService.js) — inteiramente gerido pelas
      // Cloud Functions via Admin SDK. O cliente nunca lê nem escreve o
      // documento principal diretamente.
      allow read, write: if false;

      match /confirmacoes/{uidDestino} {
        // Único ponto de escrita do cliente neste pipeline: o app do
        // "guardião" que recebeu o Push grava aqui a confirmação de
        // entrega (ver FcmService/FirebaseSyncService.confirmarEntregaAlerta)
        // — só o próprio destinatário pode confirmar a própria entrega.
        allow create, update: if request.auth != null &&
            request.auth.uid == uidDestino;
        allow read, delete: if false;
      }
    }

    match /permissoes_monitoramento/{permissaoId} {
      // Permissão bilateral de compartilhamento de localização GPS em
      // tempo real (aba Monitoramento, ver MonitoramentoService e
      // functions/monitoramentoService.js). `uidAlvo` é quem COMPARTILHA
      // a localização; `uidSolicitante` é quem a VÊ.
      //
      // Leitura: qualquer uma das duas partes envolvidas. Escrita como OR
      // de igualdades diretas (em vez de `auth.uid in [...]`) porque o
      // validador de queries do Firestore só consegue provar, a partir dos
      // filtros de uma `list`, comparações no formato
      // `resource.data.campo == request.auth.uid` — o formato `in [...]`
      // não é reconhecido e faz a query inteira cair em PERMISSION_DENIED
      // mesmo quando o solicitante tem permissão legítima.
      allow read: if request.auth != null &&
          (request.auth.uid == resource.data.uidAlvo ||
           request.auth.uid == resource.data.uidSolicitante);

      // Criação/reabertura (pendente -> nova solicitação) é feita
      // EXCLUSIVAMENTE pela Cloud Function callable `solicitarMonitoramento`
      // via Admin SDK (que ignora estas regras) — resolve o uid pelo
      // telefone server-side, evitando que o cliente precise consultar
      // `usuarios` por telefone diretamente. O cliente nunca cria este
      // documento.
      allow create: if false;

      // Atualização: só o ALVO (dono da própria localização) pode
      // responder/alternar o status, e apenas para os valores que
      // representam uma decisão sua (aprovar/negar a solicitação
      // recebida, ou bloquear/desbloquear um compartilhamento já
      // aprovado) — nunca para "pendente" (só a Cloud Function reabre um
      // ciclo) nem "expirado" (só o job agendado). Os demais campos
      // (uidAlvo, uidSolicitante, telefones, nomes) são imutáveis nesta
      // escrita do cliente.
      allow update: if request.auth != null &&
          request.auth.uid == resource.data.uidAlvo &&
          request.resource.data.uidAlvo == resource.data.uidAlvo &&
          request.resource.data.uidSolicitante == resource.data.uidSolicitante &&
          request.resource.data.status in ['aprovado', 'negado', 'bloqueado'];

      allow delete: if false;
    }

    match /contas_excluidas/{usuarioId} {
      // Marcador PERMANENTE de revogação, gravado exclusivamente pela
      // Cloud Function `excluirContaCompleta` (Admin SDK, ignora estas
      // regras) — ver exclusaoContaService.js. Nunca acessível ao
      // cliente, nem para o próprio ex-titular (que, a essa altura, nem
      // tem mais uma sessão autenticada válida).
      allow read, write: if false;
    }
  }
}
