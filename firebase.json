{
  "hosting": [
    {
      "target": "publico",
      "public": "website",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|png|svg|webp|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/f/**",
          "function": "abrirFotoSos"
        },
        {
          "source": "**",
          "destination": "/404.html"
        }
      ]
    }
  ]
}
