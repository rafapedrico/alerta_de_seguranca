{
  "hosting": [
    {
      "target": "publico",
      "public": "website",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.!(well-known)",
        "**/.!(well-known)/**",
        "**/.well-known/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|png|svg|webp|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/f/**",
          "function": "abrirFotoSos"
        },
        {
          "source": "/i/**",
          "destination": "/i.html"
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "destination": "/.well-known/apple-app-site-association"
        },
        {
          "source": "**",
          "destination": "/404.html"
        }
      ]
    }
  ]
}
