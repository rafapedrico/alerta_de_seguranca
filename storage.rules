rules_version = '2';

// Regras do Firebase Storage — usadas exclusivamente pelas fotos do
// pipeline unificado de SOS (P2, ver SosDisparoService no app e
// functions/index.js/alertaHibridoService.js).
service firebase.storage {
  match /b/{bucket}/o {
    match /sos_fotos/{usuarioId}/{arquivo} {
      // Escrita: só o próprio dono do SOS pode enviar suas fotos, e só
      // para a própria pasta (`sos_fotos/{seu-uid}/...`).
      allow write: if request.auth != null && request.auth.uid == usuarioId;

      // Leitura: PÚBLICA de propósito — o link é enviado por SMS/WhatsApp
      // (mensagem de texto) para os contatos de emergência, que abrem a
      // foto direto no navegador/WhatsApp SEM precisar estar logados no
      // app. A "segurança" aqui é por obscuridade do link (nome de
      // arquivo com timestamp + token de acesso do Firebase, nunca
      // listável), o mesmo modelo usado por qualquer link "não listado"
      // de compartilhamento (Google Drive, Dropbox, etc.) — não há
      // listagem de diretório habilitada em nenhum ponto destas regras.
      allow read: if true;
    }

    // Bloqueia explicitamente qualquer outro caminho do bucket — nunca
    // deixe uma regra futura abrir acidentalmente o resto do Storage.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
